# Copie para .env.local (desenvolvimento) e cadastre na Vercel (Settings → Environment Variables).

# Públicos (identificadores, não são segredos)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SITE_URL=https://www.diarioperdido.com.br

# SEGREDOS — marque como "Sensitive" na Vercel e nunca use o prefixo NEXT_PUBLIC_
# Token com papel "Viewer" (somente leitura). Necessário se o dataset for privado.
SANITY_API_READ_TOKEN=
# Mesmo valor configurado no webhook do Sanity. Gere com: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=
